# Copy this file to .env and fill in real values. Never commit .env.

# --- SMTP (sending) ---
# Gmail/Workspace: use an App Password, NOT your real login password.
# https://myaccount.google.com/apppasswords (needs 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-app-password-here

# --- IMAP (reply/bounce polling) ---
# Usually the same account. Override only if replies land somewhere else.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# --- Identity + legal footer (REQUIRED for commercial email, CAN-SPAM) ---
FROM_NAME=Your Name
REPLY_TO=you@yourdomain.com
PHYSICAL_ADDRESS=123 Main St, City, State ZIP, Country
UNSUBSCRIBE_TEXT=Reply STOP to opt out of future emails.
# List-Unsubscribe header (RFC 2369/8058) -- required by Gmail/Yahoo for bulk
# senders since Feb 2024, and a real deliverability signal regardless of
# volume. Defaults to REPLY_TO if left unset -- no extra setup needed.
# UNSUBSCRIBE_MAILTO=you@yourdomain.com
# Only set this if you host a one-click unsubscribe page somewhere -- without
# a URL, the true one-click (List-Unsubscribe-Post) header isn't sent.
# UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# --- Warmup / volume ---
MAILBOX_NAME=you@yourdomain.com
# Date this mailbox started warming up (YYYY-MM-DD). Controls the daily cap
# ramp -- leave as today if this is a brand new mailbox, back-date it if
# you've already been warming up for a while.
WARMUP_START_DATE=2026-09-08
# Set this to hard-override the computed ramp cap (e.g. if already warmed
# elsewhere). Leave unset to use the automatic ramp.
# DAILY_CAP_OVERRIDE=25

MIN_SEND_DELAY_SEC=60
MAX_SEND_DELAY_SEC=180

SENDER_DB_PATH=sender_state.db
